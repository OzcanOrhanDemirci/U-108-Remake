# One answer for whitespace, so that a diff never contains a change nobody made.
#
# This project is written on Windows, where tools disagree about line endings by
# default. .gitattributes settles what is stored; this settles what is typed.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj}]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown, so they are not whitespace
# to be tidied away.
trim_trailing_whitespace = false
max_line_length = 100
